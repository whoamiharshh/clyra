from flask import Flask, request, jsonify
from flask_limiter import Limiter
from flask_limiter.util import get_remote_address
from auth import authenticate_user, create_token
from database import get_db

# BUG 1: Old flask-limiter initialization (deprecated in v2.0)
# Should be: limiter = Limiter(get_remote_address, app=app)
app = Flask(__name__)
limiter = Limiter(app, key_func=get_remote_address)

@app.route('/api/login', methods=['POST'])
@limiter.limit("100/day")
def login():
    """Authenticate user and return JWT token"""
    data = request.get_json()
    
    if not data:
        return jsonify({'error': 'No data provided'}), 400
    
    username = data.get('username', '')
    password = data.get('password', '')
    
    if not username or not password:
        return jsonify({'error': 'Username and password required'}), 400
    
    user = authenticate_user(username, password)
    
    if user:
        token = create_token(user['id'])
        return jsonify({'token': token, 'user_id': user['id']}), 200
    
    return jsonify({'error': 'Invalid credentials'}), 401

@app.route('/api/users', methods=['GET'])
@limiter.limit("50/hour")
def get_users():
    """Get all users - admin only"""
    db = get_db()
    users = db.users.find({}, {'password': 0})
    return jsonify({'users': list(users)}), 200

@app.route('/api/health', methods=['GET'])
def health():
    return jsonify({'status': 'ok'}), 200

if __name__ == '__main__':
    app.run(debug=True, port=5000)

