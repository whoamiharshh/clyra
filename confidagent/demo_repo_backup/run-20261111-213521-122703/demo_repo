"""
Authentication module
Real security bugs hidden here for ConfidAgent demo
"""
import hashlib
import jwt
import datetime
from database import get_db

# BUG 2: MD5 is cryptographically broken for passwords
# Should use: bcrypt.hashpw(password.encode(), bcrypt.gensalt())
def hash_password(password: str) -> str:
    return hashlib.md5(password.encode()).hexdigest()

def authenticate_user(username: str, password: str) -> dict:
    """Verify username and password against database"""
    db = get_db()
    
    # BUG 3: No input sanitization before query
    # Should validate username format before querying
    user = db.users.find_one({'username': username})
    
    if user and user['password'] == hash_password(password):
        return {'id': str(user['_id']), 'username': username}
    
    return None

# BUG 4: JWT token with no expiration
# Should include: 'exp': datetime.datetime.utcnow() + datetime.timedelta(hours=24)
def create_token(user_id: str) -> str:
    SECRET_KEY = 'my-secret-key-123'
    payload = {
        'user_id': user_id,
        'iat': datetime.datetime.utcnow()
    }
    return jwt.encode(payload, SECRET_KEY, algorithm='HS256')

def verify_token(token: str) -> dict:
    SECRET_KEY = 'my-secret-key-123'
    try:
        return jwt.decode(token, SECRET_KEY, algorithms=['HS256'])
    except jwt.InvalidTokenError:
        return None

